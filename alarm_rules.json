{
  "rules": [
    {
      "name": "High RPM",
      "field": "rpm",
      "operator": ">",
      "threshold": 1000,
      "duration_seconds": 2,
      "severity": "warning"
    },
    {
      "name": "High Engine Load",
      "field": "load_pct",
      "operator": ">",
      "threshold": 10,
      "duration_seconds": 3,
      "severity": "warning"
    },
    {
      "name": "Elevated Coolant Temperature",
      "field": "coolant_temp_f",
      "operator": ">",
      "threshold": 115,
      "duration_seconds": 10,
      "severity": "warning"
    },
    {
      "name": "Critical Coolant Temperature",
      "field": "coolant_temp_f",
      "operator": ">",
      "threshold": 130,
      "duration_seconds": 3,
      "severity": "critical"
    },
    {
      "name": "High Oil Temperature",
      "field": "oil_temp_f",
      "operator": ">",
      "threshold": 150,
      "duration_seconds": 5,
      "severity": "warning"
    }
  ]
}