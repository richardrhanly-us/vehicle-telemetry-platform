{
  "rules": [
    {
      "name": "High RPM",
      "field": "rpm",
      "operator": ">",
      "threshold": 1000,
      "duration_seconds": 2,
      "severity": "warning"
    },
    {
      "name": "High Engine Load",
      "field": "load_pct",
      "operator": ">",
      "threshold": 90,
      "duration_seconds": 3,
      "severity": "warning"
    }
  ]
}
